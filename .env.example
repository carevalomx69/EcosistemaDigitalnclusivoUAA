# Copia este archivo como .env en el servidor y completa los valores.
# El archivo .env NO se sube al repositorio.

# Genera una clave larga y aleatoria:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Contraseña de las cuentas de demostración (incluye la del administrador)
DEMO_PASSWORD=

# 0 mientras el acceso sea por HTTP. Quitar o poner 1 cuando haya HTTPS.
COOKIE_SECURE=0

# Aviso de privacidad (deben aprobarse antes de un piloto con personas reales)
AVISO_RESPONSABLE=
AVISO_CONTACTO=
AVISO_ALOJAMIENTO=Instancia propia en Oracle Cloud
AVISO_CONSERVACION=
# Poner 0 solo cuando la instancia universitaria apruebe el texto
AVISO_BORRADOR=1
